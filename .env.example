# Copy to .env for local development. Values here are development-only.
POSTGRES_DB=payrail
POSTGRES_USER=payrail
POSTGRES_PASSWORD=payrail_dev_only
DATABASE_URL=postgresql+psycopg://payrail:payrail_dev_only@localhost:5433/payrail
REDIS_URL=redis://localhost:6380/0
NEXT_PUBLIC_API_URL=http://localhost:8001
CORS_ORIGINS=http://localhost:3001
# Base Sepolia only. Get an RPC endpoint from a provider; do not commit credentials.
BASE_SEPOLIA_RPC_URL=
PAYMENT_ROUTER_ADDRESS=
# Circle's canonical Base Sepolia USDC test token (84532); test tokens have no value.
USDC_TOKEN_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
PAYMENT_MIN_CONFIRMATIONS=2
RPC_TIMEOUT_SECONDS=10
PAYMENT_RECONCILE_INTERVAL_SECONDS=15
PAYMENT_RECONCILE_BATCH_SIZE=5
